{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "linter": {
    "rules": {
      "recommended": true,
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "error"
      }
    }
  },
  "formatter": {
    "indentWidth": 2,
    "indentStyle": "space"
  },
  "javascript": {
    "linter": {
      "enabled": true
    },
    "formatter": {
      "indentWidth": 2,
      "indentStyle": "space",
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/core/package.json",
        "packages/react-native-healthkit/package.json",
        "packages/health-records/package.json"
      ],
      "json": {
        "formatter": {
          "lineWidth": 60
        }
      }
    },
    {
      "includes": [
        "packages/core/tsconfig.cjs.json",
        "packages/core/tsconfig.esm.json",
        "packages/core/tsconfig.declarations.json",
        "packages/react-native-healthkit/tsconfig.cjs.json",
        "packages/react-native-healthkit/tsconfig.esm.json",
        "packages/react-native-healthkit/tsconfig.declarations.json",
        "packages/health-records/tsconfig.cjs.json",
        "packages/health-records/tsconfig.esm.json",
        "packages/health-records/tsconfig.declarations.json",
        "packages/react-native-healthkit/tsconfig.plugin.json",
        "packages/health-records/tsconfig.plugin.json"
      ],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    }
  ],
  "vcs": {
    "defaultBranch": "master",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*",
      "!**/.build",
      "!**/.swiftpm",
      "!**/docs",
      "!**/lib",
      "!packages/*/app.plugin.js",
      "!**/.expo",
      "!apps/example/expo-env.d.ts",
      "!**/ios",
      "!.vscode/*",
      "!.claude/*"
    ]
  }
}
