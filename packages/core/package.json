{
  "name": "@react-native-healthkit/core",
  "version": "0.0.1",
  "description": "Shared types, helpers and native code for the react-native-healthkit packages",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./types": {
      "types": "./lib/typescript/types/index.d.ts",
      "react-native": "./src/types/index.ts",
      "bun": "./src/types/index.ts",
      "import": "./lib/module/types/index.js",
      "require": "./lib/commonjs/types/index.js"
    },
    "./plugin": {
      "types": "./lib/typescript/plugin/index.d.ts",
      "import": "./lib/module/plugin/index.js",
      "require": "./lib/commonjs/plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "types": [
        "./lib/typescript/types/index.d.ts"
      ],
      "plugin": [
        "./lib/typescript/plugin/index.d.ts"
      ]
    }
  },
  "files": [
    "src",
    "react-native.config.js",
    "lib/commonjs",
    "lib/module",
    "lib/typescript",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.swift",
    "ios/**/*.modulemap",
    "*.podspec",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf lib",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.declarations.json",
    "build": "bun run clean && bun run build:cjs && bun run build:esm && bun run build:types",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "bunx @biomejs/biome format --write",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "react-native",
    "nitro",
    "healthkit",
    "ios",
    "typescript"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kingstinct"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingstinct/react-native-healthkit.git",
    "directory": "packages/core"
  },
  "author": "Robert Herber <robert@kingstinct.com> (https://github.com/robertherber)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kingstinct/react-native-healthkit/issues"
  },
  "homepage": "https://github.com/kingstinct/react-native-healthkit/tree/master/packages/core#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "~19.1.17",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-nitro-modules": "^0.35.0",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.79",
    "react-native-nitro-modules": ">=0.35"
  }
}
