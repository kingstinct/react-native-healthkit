{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true,
    "paths": {
      "@/*": ["./*"],
      "@kingstinct/react-native-healthkit": [
        "../../packages/react-native-healthkit/src/index"
      ],
      "@kingstinct/react-native-healthkit/*": [
        "../../packages/react-native-healthkit/src/*"
      ],
      "@react-native-healthkit/core": ["../../packages/core/src/index"],
      "@react-native-healthkit/core/*": ["../../packages/core/src/*"],
      "@react-native-healthkit/health-records": [
        "../../packages/health-records/src/index"
      ],
      "@react-native-healthkit/health-records/*": [
        "../../packages/health-records/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "**/*.ios.ts"
  ]
}
